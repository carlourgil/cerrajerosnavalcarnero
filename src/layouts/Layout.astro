---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Schema from "../components/Schema.astro";
import FloatingActions from "../components/FloatingActions.astro";
import { SITE } from "../lib/config";
import type { Service } from "../data/services";

interface Props {
  title: string;
  description?: string;
  schemaPage?: "home" | "inner";
  breadcrumbs?: { name: string; path: string }[];
  service?: Service;
}

const {
  title,
  description = SITE.description,
  schemaPage = "inner",
  breadcrumbs = [],
  service,
} = Astro.props;
const hasWhatsapp = !SITE.whatsapp.startsWith("[PENDIENTE");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#EE6C4D" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&display=swap"
    />
    <meta property="og:image" content={new URL("/images/apertura-de-puertas-1536.webp", Astro.site).toString()} />
    <link rel="preload" as="image" href="/images/apertura-de-puertas-1536.webp" fetchpriority="high" />
    <Schema page={schemaPage} breadcrumbs={breadcrumbs} service={service} />
  </head>
  <body>
    <div class="topbar">
      <div class="container topbar__inner">
        <span class="topbar__item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#EE6C4D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1116 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          {SITE.location} · Servicio 24 h
        </span>
        <span class="topbar__item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#EE6C4D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          Llegada: {SITE.arrivalTime}
        </span>
      </div>
    </div>

    <Header />
    <slot />
    <Footer />
    <FloatingActions />

    <nav class="sticky-bar" aria-label="Contacto rápido">
      {
        hasWhatsapp && (
          <a class="sticky-bar__item" href={`https://wa.me/${SITE.whatsapp}`}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm0 1.8a8.2 8.2 0 11-4.2 15.2l-.3-.2-2.8.8.8-2.8-.2-.3A8.2 8.2 0 0112 3.8zm-3.3 4c-.2 0-.5 0-.7.4-.3.4-.9 1-.9 2.2s.9 2.5 1 2.7c.2.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.7.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.3-1.5-.8c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.2-.1-1-.4-2-1.3-.7-.7-1.2-1.5-1.4-1.7-.1-.2 0-.4.1-.5l.4-.5.3-.5v-.5l-.7-1.7c-.2-.4-.4-.4-.6-.4z" />
            </svg>
            WhatsApp
          </a>
        )
      }

      <a class="sticky-bar__item sticky-bar__item--call" href={`tel:${SITE.phone}`}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 006.5 6.5l1.5-2 4 1.5v3a2 2 0 01-2.2 2A17 17 0 014.5 5.2 2 2 0 016.5 3z"></path>
        </svg>
        Llamar
      </a>

      <a class="sticky-bar__item" href="/#tarifas">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 10h18M7 15h4"></path>
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        </svg>
        Precios
      </a>
    </nav>
    <script
      is:inline
      define:vars={{
        day: SITE.priceDay,
        night: SITE.priceNight,
        start: SITE.dayStart,
        end: SITE.dayEnd,
      }}
    >
      // La web es estática: sin esto el precio se congelaría en la hora del build.
      const hour = Number(
        new Intl.DateTimeFormat("es-ES", {
          timeZone: "Europe/Madrid",
          hour: "numeric",
          hour12: false,
        }).format(new Date())
      );
      const isDayRate = hour >= start && hour < end;

      document.querySelectorAll("[data-price]").forEach((el) => {
        el.textContent = (isDayRate ? day : night) + "€";
      });
      document.querySelectorAll("[data-tariff]").forEach((el) => {
        el.textContent = isDayRate ? "Tarifa comercial" : "Tarifa urgencias";
      });
    </script>
  </body>
</html>
