---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Schema from "../components/Schema.astro";
import FloatingActions from "../components/FloatingActions.astro";
import { SITE } from "../lib/config";
import type { Service } from "../data/services";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  schemaPage?: "home" | "inner";
  breadcrumbs?: { name: string; path: string }[];
  service?: Service;
}

const {
  title,
  description = SITE.description,
  noindex = false,
  schemaPage = "inner",
  breadcrumbs = [],
  service,
} = Astro.props;
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site).href;
const socialImage = service?.image ? `/images/${service.image}-480.webp` : "/images/apertura-de-puertas-1536.webp";
const socialImageAlt = service?.imageAlt ?? "Cerrajero de NavaLlave comprobando el pomo de una puerta de madera abierta";
const hasWhatsapp = !SITE.whatsapp.startsWith("[PENDIENTE");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#011D54" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&display=swap"
    />
    {Astro.site && <meta property="og:image" content={new URL(socialImage, Astro.site).href} />}
    <meta property="og:image:alt" content={socialImageAlt} />
    {schemaPage === "home" && (
      <link rel="preload" as="image" href="/images/apertura-de-puertas-1536.webp" fetchpriority="high" />
    )}
    <Schema page={schemaPage} breadcrumbs={breadcrumbs} service={service} title={title} description={description} />
  </head>
  <body>
    <div class="topbar">
      <div class="container topbar__inner">
        <span class="topbar__item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#F48801" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1116 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          {SITE.location} · Servicio 24 h
        </span>
        <span class="topbar__item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#F48801" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          Llegada estimada: {SITE.arrivalTime}
        </span>
      </div>
    </div>

    <Header />
    <slot />
    <Footer />
    <FloatingActions />

    <nav class="sticky-bar" aria-label="Contacto rápido">
      {
        hasWhatsapp && (
          <a class="sticky-bar__item" href={`https://wa.me/${SITE.whatsapp}`}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm0 1.8a8.2 8.2 0 11-4.2 15.2l-.3-.2-2.8.8.8-2.8-.2-.3A8.2 8.2 0 0112 3.8zm-3.3 4c-.2 0-.5 0-.7.4-.3.4-.9 1-.9 2.2s.9 2.5 1 2.7c.2.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.7.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.3-1.5-.8c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.2-.1-1-.4-2-1.3-.7-.7-1.2-1.5-1.4-1.7-.1-.2 0-.4.1-.5l.4-.5.3-.5v-.5l-.7-1.7c-.2-.4-.4-.4-.6-.4z" />
            </svg>
            WhatsApp
          </a>
        )
      }

      <a class="sticky-bar__item sticky-bar__item--call" href={`tel:${SITE.phone}`}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 006.5 6.5l1.5-2 4 1.5v3a2 2 0 01-2.2 2A17 17 0 014.5 5.2 2 2 0 016.5 3z"></path>
        </svg>
        Llamar
      </a>

      <a class="sticky-bar__item" href="/#tarifas">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 10h18M7 15h4"></path>
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        </svg>
        Precios
      </a>
    </nav>
    <script
      is:inline
      define:vars={{
        day: SITE.priceDay,
        night: SITE.priceNight,
        start: SITE.dayStart,
        end: SITE.dayEnd,
        dayHours: SITE.dayHoursLabel,
        nightHours: SITE.nightHoursLabel,
        holidays: SITE.holidays,
        localHolidays: SITE.localHolidays,
      }}
    >
      // La web es estática: sin esto el precio se congelaría en la hora del
      // build. Se usa siempre la hora de Madrid, no la del móvil del visitante,
      // que puede estar de viaje o con el reloj mal puesto.
      const parts = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Europe/Madrid",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        hourCycle: "h23",
      }).formatToParts(new Date());
      const part = (type) => parts.find((p) => p.type === type).value;

      const today = part("year") + "-" + part("month") + "-" + part("day");
      const hour = Number(part("hour"));
      // 0 domingo … 6 sábado, sacado de la fecha de Madrid.
      const weekday = new Date(today + "T12:00:00Z").getUTCDay();

      // Jueves y Viernes Santo caen en una fecha distinta cada año, así que se
      // calcula el domingo de Pascua (algoritmo de Meeus) y se cuenta atrás.
      const year = Number(part("year"));
      const a = year % 19;
      const b = Math.floor(year / 100);
      const c = year % 100;
      const d = Math.floor(b / 4);
      const e = b % 4;
      const f = Math.floor((b + 8) / 25);
      const g = Math.floor((b - f + 1) / 3);
      const h = (19 * a + b - d - g + 15) % 30;
      const i = Math.floor(c / 4);
      const k = c % 4;
      const l = (32 + 2 * e + 2 * i - h - k) % 7;
      const m = Math.floor((a + 11 * h + 22 * l) / 451);
      const easterMonth = Math.floor((h + l - 7 * m + 114) / 31);
      const easterDay = ((h + l - 7 * m + 114) % 31) + 1;
      const easter = Date.UTC(year, easterMonth - 1, easterDay);

      const asDate = (ms) => new Date(ms).toISOString().slice(0, 10);
      const semanaSanta = [asDate(easter - 3 * 86400000), asDate(easter - 2 * 86400000)];

      const isHoliday =
        holidays.indexOf(today.slice(5)) !== -1 ||
        localHolidays.indexOf(today) !== -1 ||
        semanaSanta.indexOf(today) !== -1;

      // Tarifa comercial solo de lunes a viernes laborables, en horario. Todo
      // lo demás —noches, desde el viernes a las 21:00, y festivos— es urgencia.
      const isDayRate =
        weekday >= 1 && weekday <= 5 && !isHoliday && hour >= start && hour < end;

      document.documentElement.setAttribute("data-rate-now", isDayRate ? "day" : "night");
      document.querySelectorAll("[data-price]").forEach((el) => {
        el.textContent = (isDayRate ? day : night) + "€";
      });
      document.querySelectorAll("[data-tariff]").forEach((el) => {
        el.textContent = isDayRate ? "Tarifa comercial" : "Tarifa urgencias";
      });
      document.querySelectorAll("[data-rate-hours]").forEach((el) => {
        el.textContent = isDayRate ? dayHours : nightHours;
      });
    </script>
  </body>
</html>
