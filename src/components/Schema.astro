---
import { SITE } from "../lib/config";
import { services, type Service } from "../data/services";
import { zones } from "../data/zones";
import { faqs } from "../data/faqs";

interface Props {
  page?: "home" | "inner";
  breadcrumbs?: { name: string; path: string }[];
  service?: Service;
}

const { page = "inner", breadcrumbs = [], service } = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, "") ?? `https://${SITE.domain}`;
const businessId = `${site}/#cerrajeria`;

const business: Record<string, unknown> = {
  "@type": "Locksmith",
  "@id": businessId,
  name: SITE.businessName,
  alternateName: `${SITE.seoName} ${SITE.businessName}`,
  description: SITE.description,
  url: `${site}/`,
  logo: `${site}/images/navallave-logo.png`,
  image: `${site}/images/navallave-logo.png`,
  telephone: `+34${SITE.phone}`,
  email: SITE.email,
  priceRange: `${SITE.priceDay}€-${SITE.priceNight}€`,
  foundingDate: String(SITE.foundedYear),
  currenciesAccepted: "EUR",
  // El municipio primero y luego cada barrio: es la señal de que se cubre
  // Navalcarnero entero, que es justo lo que se quiere posicionar.
  areaServed: [
    {
      "@type": "City",
      name: SITE.location,
      address: {
        "@type": "PostalAddress",
        addressLocality: SITE.location,
        postalCode: SITE.postalCode,
        addressRegion: "Madrid",
        addressCountry: "ES",
      },
    },
    ...zones.map((z) => ({
      "@type": "Place",
      name: `${z.name}, ${SITE.location}`,
    })),
  ],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    telephone: `+34${SITE.phone}`,
    email: SITE.email,
    areaServed: "ES",
    availableLanguage: "Spanish",
    hoursAvailable: {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: "00:00",
      closes: "23:59",
    },
  },
  // Negocio a domicilio: la dirección se declara a nivel de municipio, sin
  // calle. Es lo que Google espera de un negocio con área de servicio y deja
  // igual de claro que la localidad es Navalcarnero.
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.location,
    postalCode: SITE.postalCode,
    addressRegion: "Madrid",
    addressCountry: "ES",
  },
  // Centro de Navalcarnero: el punto desde el que se mide la zona de servicio.
  geo: { "@type": "GeoCoordinates", latitude: 40.2876, longitude: -4.0122 },
  serviceArea: {
    "@type": "GeoCircle",
    geoMidpoint: { "@type": "GeoCoordinates", latitude: 40.2876, longitude: -4.0122 },
    geoRadius: "8000",
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: "00:00",
    closes: "23:59",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: `Servicios de cerrajería en ${SITE.location}`,
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: s.title,
        description: s.description,
        serviceType: s.title,
        url: `${site}/servicios/${s.slug}/`,
        areaServed: { "@type": "City", name: SITE.location },
        provider: { "@id": businessId },
      },
      ...(s.slug === "apertura-de-puertas"
        ? { price: String(SITE.priceDay), priceCurrency: "EUR" }
        : {}),
    })),
  },
};

const graph: Record<string, unknown>[] = [
  business,
  {
    "@type": "WebSite",
    "@id": `${site}/#web`,
    url: `${site}/`,
    name: SITE.businessName,
    inLanguage: "es-ES",
    publisher: { "@id": businessId },
  },
];

if (page === "home") {
  graph.push({
    "@type": "FAQPage",
    "@id": `${site}/#faq`,
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}

// En la página de un servicio, ese servicio es la entidad principal, no solo
// una entrada del catálogo de la empresa.
if (service) {
  graph.push({
    "@type": "Service",
    "@id": `${site}/servicios/${service.slug}/#servicio`,
    name: `${service.title} en ${SITE.location}`,
    description: service.description,
    serviceType: service.title,
    url: `${site}/servicios/${service.slug}/`,
    provider: { "@id": businessId },
    areaServed: { "@type": "City", name: SITE.location },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: service.title,
      itemListElement: service.bullets.map((b) => ({
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: b },
      })),
    },
    ...(service.slug === "apertura-de-puertas"
      ? {
          offers: {
            "@type": "Offer",
            price: String(SITE.priceDay),
            priceCurrency: "EUR",
            availability: "https://schema.org/InStock",
          },
        }
      : {}),
  });
}

if (breadcrumbs.length > 0) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: [{ name: "Inicio", path: "/" }, ...breadcrumbs].map((b, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: b.name,
      item: `${site}${b.path}`,
    })),
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
