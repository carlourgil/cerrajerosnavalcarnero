---
import { SITE } from "../lib/config";
import { services, type Service } from "../data/services";
import { zones } from "../data/zones";
import { faqs } from "../data/faqs";

interface Props {
  page?: "home" | "inner";
  breadcrumbs?: { name: string; path: string }[];
  service?: Service;
  title: string;
  description: string;
}

const { page = "inner", breadcrumbs = [], service, title, description } = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, "") ?? `https://${SITE.domain}`;
const businessId = `${site}/#cerrajeria`;
const pageUrl = new URL(Astro.url.pathname, `${site}/`).href;
const openingOffers = [
  {
    "@type": "Offer",
    name: "Apertura de puertas de vivienda en horario comercial",
    description: `Para cerraduras en estado normal, de ${SITE.dayHoursLabel}. Precio confirmado antes de salir.`,
    price: String(SITE.priceDay),
    priceCurrency: "EUR",
    url: `${site}/servicios/apertura-de-puertas/`,
  },
  {
    "@type": "Offer",
    name: "Apertura de puertas de vivienda en horario de urgencia",
    description: `Para cerraduras en estado normal, ${SITE.nightHoursLabel}. Precio confirmado antes de salir.`,
    price: String(SITE.priceNight),
    priceCurrency: "EUR",
    url: `${site}/servicios/apertura-de-puertas/`,
  },
];

const business: Record<string, unknown> = {
  "@type": "Locksmith",
  "@id": businessId,
  name: SITE.businessName,
  alternateName: SITE.contactName,
  description: SITE.description,
  url: `${site}/`,
  logo: `${site}/images/navallave-logo.webp`,
  image: `${site}/images/apertura-de-puertas-1536.webp`,
  telephone: `+34${SITE.phone}`,
  email: SITE.email,
  foundingDate: String(SITE.foundedYear),
  currenciesAccepted: "EUR",
  // El municipio primero y luego cada barrio: es la señal de que se cubre
  // Navalcarnero entero, que es justo lo que se quiere posicionar.
  areaServed: [
    {
      "@type": "City",
      name: SITE.location,
      address: {
        "@type": "PostalAddress",
        addressLocality: SITE.location,
        postalCode: SITE.postalCode,
        addressRegion: "Madrid",
        addressCountry: "ES",
      },
    },
    ...zones.map((z) => ({
      "@type": "Place",
      name: `${z.name}, ${SITE.location}`,
    })),
  ],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    telephone: `+34${SITE.phone}`,
    email: SITE.email,
    areaServed: "ES",
    availableLanguage: "Spanish",
    hoursAvailable: {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: "00:00",
      closes: "23:59",
    },
  },
  // Datos de contacto que también se muestran en la web.
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.streetAddress,
    addressLocality: SITE.location,
    postalCode: SITE.postalCode,
    addressRegion: "Madrid",
    addressCountry: "ES",
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: "00:00",
    closes: "23:59",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: `Servicios de cerrajería en ${SITE.location}`,
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: s.title,
        description: s.description,
        serviceType: s.title,
        url: `${site}/servicios/${s.slug}/`,
        areaServed: { "@type": "City", name: SITE.location },
        provider: { "@id": businessId },
        ...(s.slug === "apertura-de-puertas" ? { offers: openingOffers } : {}),
      },
    })),
  },
};

const graph: Record<string, unknown>[] = [
  business,
  {
    "@type": "WebPage",
    "@id": `${pageUrl}#pagina`,
    url: pageUrl,
    name: title,
    description,
    inLanguage: "es-ES",
    isPartOf: { "@id": `${site}/#web` },
    about: { "@id": businessId },
  },
  {
    "@type": "WebSite",
    "@id": `${site}/#web`,
    url: `${site}/`,
    name: SITE.businessName,
    inLanguage: "es-ES",
    publisher: { "@id": businessId },
  },
];

if (page === "home") {
  graph.push({
    "@type": "FAQPage",
    "@id": `${site}/#faq`,
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}

// En la página de un servicio, ese servicio es la entidad principal, no solo
// una entrada del catálogo de la empresa.
if (service) {
  graph.push({
    "@type": "Service",
    "@id": `${site}/servicios/${service.slug}/#servicio`,
    name: `${service.title} en ${SITE.location}`,
    description: service.description,
    serviceType: service.title,
    url: `${site}/servicios/${service.slug}/`,
    provider: { "@id": businessId },
    areaServed: { "@type": "City", name: SITE.location },
    ...(service.slug === "apertura-de-puertas"
      ? {
          offers: openingOffers,
        }
      : {}),
  });

  // Las preguntas estructuradas coinciden con las respuestas visibles del servicio.
  if (service.faqs.length > 0) {
    graph.push({
      "@type": "FAQPage",
      "@id": `${site}/servicios/${service.slug}/#faq`,
      mainEntity: service.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    });
  }
}

if (breadcrumbs.length > 0) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: [{ name: "Inicio", path: "/" }, ...breadcrumbs].map((b, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: b.name,
      item: `${site}${b.path}`,
    })),
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
