---
import { SITE } from "../lib/config";
---

<section class="section band-light">
  <div class="container">
    <div class="cta-panel">
      <div class="cta-panel__bg" aria-hidden="true">
        <span class="cta-panel__num cta-panel__num--br">24H</span>
        <span class="cta-panel__num cta-panel__num--tl">OPEN</span>
      </div>

      <div class="cta-panel__content">
        <span class="cta-panel__pill">Urgencias {SITE.location} 24h</span>
        <h2>¿Necesitas <span style="color: var(--c-red);">abrir ya</span>?</h2>

        <a href={`tel:${SITE.phone}`} class="cta-panel__phone">
          {SITE.phoneDisplay}
        </a>

        <div class="cta-panel__live">
          <span class="cta-panel__live-dot"></span>
          Técnicos de guardia en {SITE.serviceArea} ahora mismo
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-panel {
    position: relative;
    background: var(--c-black);
    border-radius: 28px;
    padding: 5rem 2rem;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }
  .cta-panel__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .cta-panel__num {
    position: absolute;
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-style: italic;
    line-height: 1;
    font-size: 18rem;
    opacity: 0.03;
    white-space: nowrap;
  }
  .cta-panel__num--br {
    bottom: -3rem;
    right: -2rem;
    color: var(--c-white);
    transform: rotate(-12deg);
  }
  .cta-panel__num--tl {
    top: -3rem;
    left: -2rem;
    color: var(--c-red);
    transform: rotate(12deg);
  }
  .cta-panel__pill {
    display: inline-block;
    background: var(--c-red);
    color: var(--c-black);
    padding: 0.6rem 1.5rem;
    border-radius: var(--r-pill);
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    font-size: var(--fs-xs);
    letter-spacing: 0.15em;
    margin-bottom: 2rem;
  }
  .cta-panel h2 {
    color: var(--c-white);
    font-size: clamp(2.75rem, 2rem + 5vw, 5.5rem);
    margin-bottom: 2.5rem;
  }
  .cta-panel__phone {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(2.5rem, 2rem + 4vw, 4.5rem);
    color: var(--c-white);
    display: inline-block;
    transition: color var(--ease);
  }
  .cta-panel__phone:hover {
    color: var(--c-red);
  }
  .cta-panel__live {
    margin-top: 2.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--c-grey-400);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
  }
  .cta-panel__live-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #4ADE80;
    animation: cta-pulse 1.6s infinite;
  }
  @keyframes cta-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
</style>
