---
import { SITE } from "../lib/config";
---

<section class="section band-muted">
  <div class="container">
    <div class="cta-panel">
      <div class="cta-panel__bg" aria-hidden="true">
        <span class="cta-panel__dots"></span>
        <span class="cta-panel__word cta-panel__word--br">24H</span>
        <span class="cta-panel__word cta-panel__word--tl">OPEN</span>
      </div>

      <div class="cta-panel__content">
        <span class="cta-panel__pill">Urgencias {SITE.location} 24h</span>

        <h2 class="cta-panel__title">¿Necesitas <br /><span class="accent">abrir ya</span>?</h2>

        <div class="cta-panel__tiles">
          <div class="cta-panel__tile">
            <span class="cta-panel__tile-label" data-tariff>Tarifa comercial</span>
            <span class="cta-panel__tile-value" data-price>{SITE.priceDay}€</span>
          </div>
          <div class="cta-panel__tile">
            <span class="cta-panel__tile-label">Llegada media</span>
            <span class="cta-panel__tile-value">{SITE.arrivalTime}</span>
          </div>
        </div>

        <a href={`tel:${SITE.phone}`} class="cta-panel__phone">
          <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 006.5 6.5l1.5-2 4 1.5v3a2 2 0 01-2.2 2A17 17 0 014.5 5.2 2 2 0 016.5 3z"></path>
          </svg>
          {SITE.phoneDisplay}
        </a>

        <div class="cta-panel__live">
          <span class="ping ping--green"></span>
          Técnicos de guardia en {SITE.serviceArea} ahora mismo
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-panel {
    position: relative;
    max-width: 64rem;
    margin-inline: auto;
    padding: clamp(3rem, 6vw, 6rem) clamp(1.5rem, 4vw, 4rem);
    background: var(--c-navy);
    border-radius: var(--r-3xl);
    box-shadow: var(--sh-2xl);
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }
  .cta-panel__bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .cta-panel__dots {
    position: absolute;
    inset: 0;
    opacity: .03;
    background-image: radial-gradient(circle, #EE6C4D 1.5px, transparent 1.5px);
    background-size: 32px 32px;
  }
  .cta-panel__word {
    position: absolute;
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    font-style: italic;
    font-size: clamp(12rem, 25vw, 25rem);
    line-height: 1;
    opacity: .02;
    white-space: nowrap;
  }
  .cta-panel__word--br { bottom: -5rem; right: -5rem; color: var(--c-white); transform: rotate(-15deg); }
  .cta-panel__word--tl { top: -5rem; left: -5rem; color: var(--c-orange); transform: rotate(15deg); }

  .cta-panel__content { display: flex; flex-direction: column; align-items: center; }
  .cta-panel__pill {
    padding: .5rem 1.5rem;
    margin-bottom: 2.5rem;
    background: var(--c-orange);
    color: var(--c-navy);
    border-radius: var(--r-pill);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: var(--fw-black);
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: .3em;
  }
  .cta-panel__title {
    color: var(--c-white);
    font-size: clamp(3rem, 2rem + 7vw, 8rem);
    line-height: .85;
    margin-bottom: 3rem;
  }

  .cta-panel__tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    width: 100%;
    max-width: 42rem;
    margin-bottom: 3rem;
  }
  .cta-panel__tile {
    padding: 2rem;
    background: rgba(255, 255, 255, .05);
    border: 1px solid rgba(255, 255, 255, .1);
    border-radius: var(--r-xl);
    backdrop-filter: blur(8px);
  }
  .cta-panel__tile-label {
    display: block;
    margin-bottom: .5rem;
    font-size: var(--fs-sm);
    font-weight: var(--fw-black);
    text-transform: uppercase;
    letter-spacing: .15em;
    color: var(--c-orange);
  }
  .cta-panel__tile-value {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    font-weight: var(--fw-black);
    font-style: italic;
    text-transform: uppercase;
    line-height: 1;
    color: var(--c-white);
  }

  .cta-panel__phone {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.5rem + 6vw, 6rem);
    font-weight: var(--fw-black);
    letter-spacing: -.045em;
    color: var(--c-white);
  }
  .cta-panel__phone:hover { color: var(--c-orange); }

  .cta-panel__live {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 4rem;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: .15em;
    color: var(--c-gray-400);
  }
</style>
