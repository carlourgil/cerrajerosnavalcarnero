---
import { SITE } from "../lib/config";
import { services } from "../data/services";
---

<footer class="footer">
  <div class="container">
    <div class="footer__cols">
      <div>
        {/* El logo es azul marino sobre blanco; aquí el fondo es azul marino,
            así que la marca se compone en texto con los dos colores. */}
        <p class="display footer__heading footer__brand">Nava<span>Llave</span></p>
        <p class="measure">{SITE.description}</p>
      </div>

      <div>
        <p class="display footer__heading">Servicios</p>
        <ul>
          {
            services.map((s) => (
              <li>
                <a href={`/servicios/${s.slug}/`}>{s.title}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="display footer__heading">Contacto</p>
        <ul>
          <li>{SITE.contactName}</li>
          <li>{SITE.streetAddress}</li>
          <li>{SITE.postalCode}, {SITE.addressCity}</li>
          <li>Teléfono: <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        </ul>
      </div>

      <div>
        <p class="display footer__heading">Legal</p>
        <ul>
          <li><a href="/aviso-legal/">Aviso Legal</a></li>
          <li><a href="/politica-privacidad/">Política de Privacidad</a></li>
          <li><a href="/politica-cookies/">Política de Cookies</a></li>
          <li><button type="button" class="footer__cookie-settings" data-cookie-settings>Configurar cookies</button></li>
        </ul>
      </div>
    </div>

    <div class="footer__legal">
      © {new Date().getFullYear()} {SITE.businessName}. Todos los derechos reservados.
    </div>
  </div>
</footer>

<style>
  .footer__cookie-settings { color: inherit; background: transparent; border: 0; padding: 0; font: inherit; text-align: left; cursor: pointer; }
  .footer__cookie-settings:hover { text-decoration: underline; }
  .footer__cookie-settings:focus-visible { outline: 2px solid var(--c-orange); outline-offset: 4px; }
</style>
