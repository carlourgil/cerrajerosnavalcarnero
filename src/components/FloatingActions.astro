---
import { SITE } from "../lib/config";

const hasWhatsapp = !SITE.whatsapp.startsWith("[PENDIENTE");
---

<div class="fab">
  {
    hasWhatsapp && (
      <a
        class="fab__btn fab__btn--wa"
        href={`https://wa.me/${SITE.whatsapp}`}
        aria-label="Escribir por WhatsApp"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm0 1.8a8.2 8.2 0 11-4.2 15.2l-.3-.2-2.8.8.8-2.8-.2-.3A8.2 8.2 0 0112 3.8zm-3.3 4c-.2 0-.5 0-.7.4-.3.4-.9 1-.9 2.2s.9 2.5 1 2.7c.2.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.7.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.3-1.5-.8c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.2-.1-1-.4-2-1.3-.7-.7-1.2-1.5-1.4-1.7-.1-.2 0-.4.1-.5l.4-.5.3-.5v-.5l-.7-1.7c-.2-.4-.4-.4-.6-.4z" />
        </svg>
      </a>
    )
  }

  <a class="fab__btn fab__btn--call" href={`tel:${SITE.phone}`} aria-label={`Llamar al ${SITE.phoneDisplay}`}>
    <span class="fab__pulse" aria-hidden="true"></span>
    <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 006.5 6.5l1.5-2 4 1.5v3a2 2 0 01-2.2 2A17 17 0 014.5 5.2 2 2 0 016.5 3z"></path>
    </svg>
  </a>
</div>

<style>
  .fab {
    position: fixed;
    right: 1.25rem;
    bottom: 1.5rem;
    z-index: 70;
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }
  .fab__btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    color: var(--c-white);
    box-shadow: 0 12px 24px -8px rgba(12, 28, 46, .45);
    transition: transform var(--ease), box-shadow var(--ease);
  }
  .fab__btn:hover {
    color: var(--c-white);
    transform: translateY(-3px) scale(1.04);
    box-shadow: 0 18px 30px -10px rgba(12, 28, 46, .55);
  }
  .fab__btn--wa { background: #25D366; }
  .fab__btn--call { background: var(--c-orange); }

  .fab__pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--c-orange);
    animation: fab-pulse 2.2s cubic-bezier(0, 0, .2, 1) infinite;
    z-index: -1;
  }
  @keyframes fab-pulse {
    0% { transform: scale(1); opacity: .55; }
    70%, 100% { transform: scale(1.75); opacity: 0; }
  }

  /* En móvil manda la barra fija inferior: el flotante se sube para no taparla. */
  @media (max-width: 767px) {
    .fab { bottom: 5rem; right: 1rem; }
    .fab__btn { width: 50px; height: 50px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fab__pulse { animation: none; }
  }
</style>
