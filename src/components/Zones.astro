---
import { zones } from "../data/zones";
import { SITE } from "../lib/config";

const defaultZone = zones.find((zone) => zone.slug === "centro") ?? zones[0];
---

<section id="zonas" class="section band-dark">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Mapa de cobertura</span>
      <h2>¿En qué zona <span class="accent">estás</span>?</h2>
      <p class="subhead">Elige tu barrio y te decimos cuánto tardamos en llegar.</p>
    </div>

    <div class="coverage">
      <div class="coverage__list">
        <p class="coverage__group">Barrios de {SITE.location}</p>
        <div class="coverage__buttons">
          {
            zones.map((z) => (
              <button
                type="button"
                class="coverage__zone"
                aria-controls="coverage-result"
                aria-pressed={z.slug === defaultZone.slug ? "true" : "false"}
                data-zone={z.name}
                data-href={`/zonas/${z.slug}/`}
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--c-orange)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1116 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                {z.name}
              </button>
            ))
          }
        </div>
      </div>

      <div class="coverage__panel">
        <div id="coverage-result" class="coverage__result">
          <span class="coverage__result-label">Cerrajero en</span>
          <h3 class="coverage__result-zone" aria-live="polite" data-coverage-zone>{defaultZone.name}</h3>
          <div class="coverage__time">
            <span class="ping ping--green"></span>
            Llegada estimada: <strong>{SITE.arrivalTime}</strong>
          </div>
          <a class="btn btn--block" href={`tel:${SITE.phone}`}>Llamar ahora</a>
          <a class="coverage__link" href={`/zonas/${defaultZone.slug}/`} data-coverage-link>
            Ver la página de {defaultZone.name}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .coverage {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (max-width: 900px) { .coverage { grid-template-columns: 1fr; } }

  .coverage__list {
    padding: 2.5rem;
    background: rgba(255, 255, 255, .04);
    border: 1px solid rgba(255, 255, 255, .1);
    border-radius: var(--r-xl);
  }
  .coverage__group {
    margin: 0 0 1rem;
    font-size: var(--fs-2xs);
    font-weight: var(--fw-black);
    text-transform: uppercase;
    letter-spacing: .3em;
    color: var(--c-orange);
  }
  .coverage__group + .coverage__buttons { margin-bottom: 2rem; }
  .coverage__buttons { display: flex; flex-wrap: wrap; gap: .75rem; margin-bottom: 2rem; }
  .coverage__buttons:last-child { margin-bottom: 0; }

  .coverage__zone {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 48px;
    padding: 0 1.1rem;
    background: rgba(255, 255, 255, .06);
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: var(--r-xs);
    font: inherit;
    font-weight: 600;
    color: #D7E0E9;
    cursor: pointer;
    transition: background var(--ease), color var(--ease), border-color var(--ease), transform var(--ease);
  }
  .coverage__zone:hover { background: rgba(244,136,1,.16); border-color: rgba(244,136,1,.5); color: var(--c-white); transform: translateY(-2px); }
  .coverage__zone[aria-pressed="true"] {
    background: var(--c-orange);
    border-color: var(--c-orange);
    color: var(--c-white);
  }

  .coverage__panel {
    padding: 2.5rem;
    background: var(--c-white);
    border-radius: var(--r-xl);
    box-shadow: 0 30px 60px -25px rgba(0, 0, 0, .55);
    min-height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .coverage__result-label {
    font-size: var(--fs-2xs);
    font-weight: var(--fw-black);
    text-transform: uppercase;
    letter-spacing: .3em;
    color: var(--c-orange);
  }
  .coverage__result-zone { margin: .5rem 0 1.25rem; font-size: 2rem; }
  .coverage__time {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin-bottom: 1.75rem;
    font-weight: 600;
    color: var(--c-gray-600);
  }
  .coverage__time strong { color: var(--c-ink); }
  .coverage__link {
    display: block;
    margin-top: 1rem;
    text-align: center;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--c-navy);
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  .coverage__link:hover { color: var(--c-ink); }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".coverage__zone");
  const zoneName = document.querySelector("[data-coverage-zone]");
  const zoneLink = document.querySelector<HTMLAnchorElement>("[data-coverage-link]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const { zone, href } = button.dataset;
      if (!zoneName || !zoneLink || !zone || !href) return;

      buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      button.setAttribute("aria-pressed", "true");

      zoneName.textContent = zone;
      zoneLink.href = href;
      zoneLink.textContent = `Ver la página de ${zone}`;
    });
  });
</script>
