---
import { services } from "../data/services";
import { SITE } from "../lib/config";
---

<section id="servicios" class="section band-light">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Nuestros servicios</span>
      <h2>Servicios de cerrajería en <span class="accent">{SITE.location}</span></h2>
      <p class="subhead">Soluciones profesionales para tu hogar o negocio. Calidad garantizada.</p>
    </div>

    <div class="grid">
      {
        services.map((s) => (
          <a href={`/servicios/${s.slug}/`} class="card">
            <div class="card__body">
              <span class="card__icon">
                {s.slug === "apertura-de-puertas" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 21V5a2 2 0 012-2h9a2 2 0 012 2v16"></path>
                    <path d="M3 21h18"></path>
                    <circle cx="14" cy="12" r="1"></circle>
                  </svg>
                )}
                {s.slug === "bombines-antibumping" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="12" r="5"></circle>
                    <path d="M14 12h7M18 12v4"></path>
                  </svg>
                )}
                {s.slug === "apertura-de-coches" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 14l1.4-4.6A2 2 0 016.3 8h11.4a2 2 0 011.9 1.4L21 14v4h-2.5"></path>
                    <path d="M3 14v4h2.5M3 14h18"></path>
                    <circle cx="7" cy="17" r="1.5"></circle>
                    <circle cx="17" cy="17" r="1.5"></circle>
                  </svg>
                )}
                {s.slug === "apertura-de-cajas-fuertes" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                    <circle cx="11" cy="12" r="3.5"></circle>
                    <path d="M11 8.5V12M17.5 9v6"></path>
                  </svg>
                )}
                {s.slug === "cambio-de-cerraduras" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="10" width="16" height="11" rx="2"></rect>
                    <path d="M8 10V7a4 4 0 018 0v3"></path>
                  </svg>
                )}
                {s.slug === "amaestramiento" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="8" cy="9" r="4"></circle>
                    <path d="M11 11l8 8M16 16l2 2M14 14l2 2"></path>
                  </svg>
                )}
                {s.slug === "urgencias-24h" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"></path>
                  </svg>
                )}
                {s.slug === "mantenimiento" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15.5 3.5a5 5 0 00-6.1 6.6L3.6 15.9a2 2 0 102.8 2.8l5.8-5.8a5 5 0 006.6-6.1l-2.9 2.9-2.6-.7-.7-2.6 2.9-2.9z"></path>
                  </svg>
                )}
              </span>

              <h4>{s.title}</h4>
              <p>{s.description}</p>
              <span class="card__link">
                Ver detalles
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
