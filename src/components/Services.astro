---
import { services } from "../data/services";
import { SITE } from "../lib/config";
---

<section id="servicios" class="section band-light">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Nuestros servicios</span>
      <h2>Soluciones de cerrajería en <span class="accent">{SITE.location}</span></h2>
      <p class="subhead">
        Para tu casa, tu comunidad o tu negocio. Con el precio cerrado antes de que salgamos.
      </p>
    </div>

    <div class="grid">
      {
        services.map((s) => (
          <a href={`/servicios/${s.slug}/`} class="card">
            <span class="card__figure">
              {s.image ? (
                <img
                  src={`/images/${s.image}-480.webp`}
                  alt={s.imageAlt ?? ""}
                  width="480"
                  height="320"
                  loading="lazy"
                  decoding="async"
                  class="card__media"
                />
              ) : (
                <span class="card__media card__media--blank" aria-hidden="true">
                  <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15.5 3.5a5 5 0 00-6.1 6.6L3.6 15.9a2 2 0 102.8 2.8l5.8-5.8a5 5 0 006.6-6.1l-2.9 2.9-2.6-.7-.7-2.6 2.9-2.9z" />
                  </svg>
                </span>
              )}

              <span class="card__badge" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="10" r="5" />
                  <path d="M13 13l7 7M17 17l2.5-2.5" />
                </svg>
              </span>
            </span>

            <div class="card__body">
              <h3 class="card__title">{s.title}</h3>
              <p>{s.short}</p>

              <div class="card__foot">
                {s.slug === "apertura-de-puertas" ? (
                  <span class="card__price">
                    desde <strong data-price>{SITE.priceDay}€</strong>
                  </span>
                ) : (
                  <span class="card__price card__price--quote">Precio cerrado</span>
                )}
                <span class="card__link">
                  Ver detalles
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Insignia superpuesta entre la foto y el texto: da profundidad y remata
     la tarjeta, como en las webs de referencia. */
  .card__figure { position: relative; display: block; }
  .card__badge {
    position: absolute;
    bottom: 0;
    left: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--r-xs);
    background: var(--c-white);
    color: var(--c-orange);
    box-shadow: 0 10px 20px -8px rgba(12, 28, 46, .35);
    transform: translateY(-50%);
    transition: background var(--ease), color var(--ease);
  }
  .card:hover .card__badge { background: var(--c-orange); color: var(--c-white); }
  .card__body { padding-top: 2.25rem; }
  .card__media--blank {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    background: var(--c-orange-50);
    color: var(--c-orange);
  }
  .card__title {
    margin: 0;
    font-size: 1.25rem;
    color: var(--c-navy);
  }
  .card__foot {
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--c-gray-100);
  }
  .card__price {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-gray-500);
    white-space: nowrap;
  }
  .card__price strong {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--c-navy);
  }
  .card__price--quote { color: var(--c-gray-400); }
  .card__link { margin-top: 0; white-space: nowrap; }
</style>
