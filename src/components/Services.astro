---
import { services } from "../data/services";
import { SITE } from "../lib/config";
---

<section id="servicios" class="section band-light">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Nuestros servicios</span>
      <h2>Soluciones de cerrajería en <span class="accent">{SITE.location}</span></h2>
      <p class="subhead">
        Para tu casa, tu comunidad o tu negocio. Con el precio cerrado antes de que salgamos.
      </p>
    </div>

    <div class="grid">
      {
        services.map((s) => (
          <a href={`/servicios/${s.slug}/`} class="card">
            {s.image && (
              <img
                src={`/images/${s.image}-480.webp`}
                alt={`${s.title} en ${SITE.location}`}
                width="480"
                height="320"
                loading="lazy"
                decoding="async"
                class="card__media"
              />
            )}

            <div class="card__body">
              <h3 class="card__title">{s.title}</h3>
              <p>{s.short}</p>

              <div class="card__foot">
                {s.slug === "apertura-de-puertas" ? (
                  <span class="card__price">
                    desde <strong>{SITE.priceDay} €</strong>
                  </span>
                ) : (
                  <span class="card__price card__price--quote">Precio cerrado</span>
                )}
                <span class="card__link">
                  Ver detalles
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .card__title {
    margin: 0;
    font-size: 1.25rem;
    color: var(--c-navy);
  }
  .card__foot {
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--c-gray-100);
  }
  .card__price {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-gray-500);
  }
  .card__price strong {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--c-navy);
  }
  .card__price--quote { color: var(--c-gray-400); }
  .card__link { margin-top: 0; }
</style>
