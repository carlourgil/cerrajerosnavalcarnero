---
import { testimonials } from "../data/testimonials";
import { SITE } from "../lib/config";

const hasGmb = SITE.gmbUrl && !SITE.gmbUrl.startsWith("[PENDIENTE");
const count = testimonials.length;
const avgRating = count > 0 ? testimonials.reduce((sum, t) => sum + t.rating, 0) / count : 0;
---

<section id="opiniones" class="section band-light">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Lo que dicen nuestros vecinos</span>
      <h2>Opiniones <span class="accent">reales</span></h2>
      {
        count > 0 ? (
          <p class="subhead">
            {count} {count === 1 ? "opinión" : "opiniones"} de clientes en {SITE.location}
          </p>
        ) : (
          <p class="subhead">Estamos empezando a construir nuestra reputación en {SITE.location}</p>
        )
      }
    </div>

    {
      count > 0 && (
        <div class="rating">
          <div class="rating__score">
            <span class="rating__number">{avgRating.toFixed(1)}</span>
            <div>
              <div class="rating__stars" aria-hidden="true">
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill={i < Math.round(avgRating) ? "currentColor" : "none"} stroke="currentColor" stroke-width="1.5">
                    <path d="M12 2.5l2.9 6.1 6.6.7-4.9 4.5 1.3 6.6-5.9-3.3-5.9 3.3 1.3-6.6-4.9-4.5 6.6-.7z" />
                  </svg>
                ))}
              </div>
              <span class="rating__label">Media de clientes</span>
            </div>
          </div>
        </div>
      )
    }

    <div class="reviews">
      {
        count > 0 ? (
          testimonials.map((t) => (
            <div class="review">
              <div class="review__header">
                <div>
                  <h4 class="review__name">{t.name}</h4>
                  <span class="review__zone">{t.zone}</span>
                </div>
                <div class="review__stars" aria-hidden="true">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <svg width="14" height="14" viewBox="0 0 24 24" fill={i < t.rating ? "currentColor" : "none"} stroke="currentColor" stroke-width="1.5">
                      <path d="M12 2.5l2.9 6.1 6.6.7-4.9 4.5 1.3 6.6-5.9-3.3-5.9 3.3 1.3-6.6-4.9-4.5 6.6-.7z" />
                    </svg>
                  ))}
                </div>
              </div>
              <span class="review__service">{t.service}</span>
              <p class="review__text">«{t.text}»</p>
              <p class="review__date">{t.date}</p>
            </div>
          ))
        ) : (
          <div class="review review--empty">
            <h4 class="review__name">Sé de los primeros en opinar</h4>
            <p class="review__text">
              Cuando te atendamos, cuéntanos qué tal fue. Publicamos solo opiniones reales de clientes de
              {" "}{SITE.location}.
            </p>
          </div>
        )
      }
    </div>

    <div class="text-center" style="margin-top: 3rem;">
      {
        hasGmb ? (
          <a href={SITE.gmbUrl} class="btn btn--ghost">Ver todas las opiniones en Google</a>
        ) : (
          <a href={`tel:${SITE.phone}`} class="btn btn--ghost">Llámanos y cuéntanos tu experiencia</a>
        )
      }
    </div>
  </div>
</section>

<style>
  .rating {
    display: flex;
    justify-content: center;
    margin-bottom: 3rem;
  }
  .rating__score {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 2.5rem;
    background: var(--c-white);
    border: 1px solid var(--c-gray-100);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-card);
  }
  .rating__number {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: var(--fw-black);
    font-style: italic;
    line-height: 1;
    color: var(--c-navy);
  }
  .rating__stars { display: flex; gap: 2px; color: var(--c-orange); }
  .rating__label { font-size: var(--fs-xs); color: var(--c-gray-500); }

  .reviews {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
  .review {
    padding: 2.5rem;
    background: var(--c-white);
    border: 1px solid var(--c-gray-100);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-card);
    transition: transform var(--ease), box-shadow var(--ease);
  }
  .review:hover { transform: translateY(-6px); box-shadow: var(--sh-float); }
  .review__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .review__name { margin: 0; font-size: 1.125rem; color: var(--c-navy); }
  .review__zone { font-size: var(--fs-xs); color: var(--c-gray-400); }
  .review__stars { display: flex; gap: 1px; color: var(--c-orange); flex-shrink: 0; }
  .review__service {
    display: inline-block;
    margin-bottom: 1rem;
    padding: .25rem .875rem;
    background: rgba(238, 108, 77, .1);
    color: var(--c-orange);
    border-radius: var(--r-pill);
    font-size: var(--fs-xs);
    font-weight: var(--fw-black);
  }
  .review__text { color: var(--c-gray-500); font-weight: 500; margin-bottom: .75rem; }
  .review__date { margin: 0; font-size: var(--fs-xs); color: var(--c-gray-400); }
  .review--empty { grid-column: 1 / -1; max-width: 34rem; margin-inline: auto; text-align: center; }
</style>
