---
import { SITE } from "../lib/config";
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <div class="hero__badge">
        <span class="ping"></span>
        Técnico de guardia ahora mismo en {SITE.location}
      </div>

      <h1>
        Cerrajero en {SITE.location},<br />
        <span class="accent">a cualquier hora</span>
      </h1>

      <p class="subhead">
        Te has quedado fuera, se ha roto la llave o han forzado la cerradura. Llegamos en{" "}
        <strong>{SITE.arrivalTime}</strong> y te decimos el precio antes de salir.
      </p>

      <div class="hero__cta">
        <a href={`tel:${SITE.phone}`} class="btn btn--accent">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 006.5 6.5l1.5-2 4 1.5v3a2 2 0 01-2.2 2A17 17 0 014.5 5.2 2 2 0 016.5 3z"></path>
          </svg>
          <span class="btn__stack">
            <span class="btn__eyebrow">Llama ahora</span>
            <span>{SITE.phoneDisplay}</span>
          </span>
        </a>

        <a href={`https://wa.me/${SITE.whatsapp}`} class="btn btn--wa">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.5 8.5 0 01-12.3 7.6L3 21l1.9-5.6A8.5 8.5 0 1121 11.5z"></path>
          </svg>
          WhatsApp
        </a>
      </div>

      <ul class="hero__facts">
        <li>
          <strong>{SITE.priceDay} €</strong>
          <span>apertura de {SITE.dayStart}:00 a {SITE.dayEnd}:00</span>
        </li>
        <li>
          <strong>{SITE.arrivalTime}</strong>
          <span>llegada media</span>
        </li>
        <li>
          <strong>24/365</strong>
          <span>noches y festivos</span>
        </li>
      </ul>
    </div>

    <div class="hero__figure">
      <img
        src="/images/apertura-de-puertas-1536.webp"
        alt={`Cerrajero abriendo una puerta en ${SITE.location}`}
        width="1439"
        height="959"
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero__stamp">
        <strong>Sin romper la puerta</strong>
        <span>Ganzúa y descarrile, la cerradura sigue funcionando</span>
      </div>
    </div>
  </div>
</section>
