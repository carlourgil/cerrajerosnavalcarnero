---
import { SITE } from "../lib/config";

const cards = [
  { title: "Apertura Urgente", subtitle: "Sin romper tu puerta" },
  { title: "Cerraduras", subtitle: "Cambio y alta seguridad" },
  { title: "Servicio 24h", subtitle: "Noches y festivos" },
];
---

<section class="hero hero--split">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__grid">
    <div class="hero__copy">
      <div class="hero__badge">
        <span class="hero__dot"></span>
        <span>Cerrajeros reales 24h en {SITE.location}</span>
      </div>

      <h1>
        ¿Te has quedado fuera?<br />
        <span style="color: var(--c-red); font-style: italic;">Cerrajeros {SITE.location}</span>
      </h1>

      <p class="subhead">
        Tu cerrajero de confianza en {SITE.serviceArea}. Llegamos en <strong>{SITE.arrivalTime}</strong>.
      </p>

      <div class="hero__row">
        <a href={`tel:${SITE.phone}`} class="btn btn--accent">
          <span class="hero__call-label">
            <span class="hero__call-eyebrow">Llama ahora</span>
            <span>{SITE.phoneDisplay}</span>
          </span>
        </a>

        <div class="hero__stats">
          <div>
            <strong>{SITE.arrivalTime}</strong>
            <span>Llegada media</span>
          </div>
          <div>
            <strong>24h</strong>
            <span>Todos los días</span>
          </div>
        </div>
      </div>
    </div>

    <div class="hero__cards">
      {
        cards.map((c) => (
          <div class="hero__float-card">
            <div class="hero__float-title">{c.title}</div>
            <div class="hero__float-sub">{c.subtitle}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero--split {
    display: block;
    padding: 0;
    min-height: 0;
  }
  .hero__glow {
    position: absolute;
    top: -120px;
    right: -120px;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--c-red-glow), transparent 70%);
    z-index: -1;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3.5rem;
    align-items: center;
    padding: 150px var(--pad-x) 100px;
    max-width: var(--container);
    margin-inline: auto;
    text-align: left;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 22px;
    border-radius: var(--r-pill);
    background: rgba(238, 108, 77, 0.12);
    border: 1px solid rgba(238, 108, 77, 0.35);
    color: var(--c-red);
    font-weight: var(--fw-bold);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1.75rem;
  }
  .hero__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c-red);
    animation: hero-pulse 1.6s infinite;
  }
  @keyframes hero-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
  .hero h1 span.accent {
    color: var(--c-red);
  }
  .hero__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem;
    margin-top: 2rem;
  }
  .hero__call-label {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.1;
  }
  .hero__call-eyebrow {
    font-size: 11px;
    opacity: 0.8;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }
  .hero__stats {
    display: flex;
    gap: 2rem;
  }
  .hero__stats div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .hero__stats strong {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    font-size: 1.15rem;
    color: var(--c-white);
  }
  .hero__stats span {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-grey-400);
    font-weight: var(--fw-bold);
  }
  .hero__cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .hero__float-card {
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(6px);
    padding: 1.75rem;
    transition: background var(--ease), transform var(--ease);
  }
  .hero__float-card:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateX(6px);
  }
  .hero__float-title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    color: var(--c-white);
    font-size: 1.15rem;
  }
  .hero__float-sub {
    color: var(--c-grey-400);
    font-weight: var(--fw-bold);
    font-size: var(--fs-sm);
  }
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      padding-top: 120px;
    }
  }
</style>
