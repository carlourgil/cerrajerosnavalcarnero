---
import { SITE } from "../lib/config";

// Redondeado a la baja a múltiplos de 5: el cliente dio el año aproximado,
// así que la cifra se queda corta antes que exagerada.
const yearsRounded = Math.floor((new Date().getFullYear() - SITE.foundedYear) / 5) * 5;

const features = [
  {
    title: "Presupuesto cerrado",
    desc: "Te damos el precio final por teléfono. Sin sorpresas, sin abusos.",
    icon: "check",
  },
  {
    title: "Apertura sin daños",
    desc: "Expertos en ganzuado y técnicas limpias. Tu puerta quedará perfecta.",
    icon: "shield",
  },
];
---

<section id="ventajas" class="section band-muted">
  <div class="container">
    <div class="zigzag">
      <div>
        <h2>
          Tu vecino de <span class="accent">{SITE.location}</span>
        </h2>
        <p class="subhead measure">
          En <strong>{SITE.businessName}</strong> atendemos avisos en todo {SITE.location}.
          Cuando llamas, hablas directamente con el cerrajero que va a atenderte.
        </p>

        <div class="whyus__list">
          {
            features.map((f) => (
              <div class="whyus__card">
                <span class="whyus__icon">
                  {f.icon === "check" && (
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9"></circle>
                      <path d="M8.5 12.5l2.5 2.5 4.5-5"></path>
                    </svg>
                  )}
                  {f.icon === "shield" && (
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3l7 3v5c0 4.4-2.9 8.3-7 9.5C7.9 19.3 5 15.4 5 11V6l7-3z"></path>
                    </svg>
                  )}
                </span>
                <div>
                  <h3 class="whyus__title">{f.title}</h3>
                  <p class="whyus__desc">{f.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="whyus__media">
        <img
          src="/images/furgoneta-navallave-1200.webp"
          srcset="/images/furgoneta-navallave-760.webp 760w, /images/furgoneta-navallave-1200.webp 1200w"
          sizes="(min-width: 900px) 40vw, 100vw"
          alt={`Furgoneta rotulada de ${SITE.businessName}, cerrajeros en ${SITE.location}`}
          width="1200"
          height="800"
          loading="lazy"
          decoding="async"
          class="whyus__photo"
        />
        <div class="whyus__badge">
          <span class="whyus__badge-eyebrow">Confianza local</span>
          <span class="whyus__badge-value">+{yearsRounded} años</span>
          <span class="whyus__badge-sub">Cerrajeros desde {SITE.foundedYear}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .whyus__list { display: grid; gap: 2rem; margin-top: 3rem; }
  .whyus__card {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 2rem;
    background: var(--c-gray-50);
    border: 1px solid var(--c-gray-100);
    border-radius: var(--r-xl);
    transition: background var(--ease), box-shadow var(--ease);
  }
  .whyus__card:hover { background: var(--c-white); box-shadow: var(--sh-float); }
  .whyus__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: var(--r-sm);
    background: rgba(244, 136, 1, .1);
    color: var(--c-orange);
    transition: background var(--ease), color var(--ease);
  }
  .whyus__card:hover .whyus__icon { background: var(--c-orange); color: var(--c-white); }
  .whyus__title {
    margin: 0 0 .25rem;
    font-size: 1.5rem;
    color: var(--c-navy);
  }
  .whyus__desc { margin: 0; color: var(--c-gray-500); font-weight: 500; }

  /* Bloque naranja desplazado detrás de la foto: aporta profundidad y color
     sin recargar la sección. */
  .whyus__media { position: relative; }
  .whyus__media::before {
    content: "";
    position: absolute;
    inset: 1.75rem -1.75rem -1.75rem 1.75rem;
    border-radius: var(--r-lg);
    background: var(--t-orange);
    z-index: 0;
  }
  .whyus__media > * { position: relative; z-index: 1; }
  .whyus__photo {
    display: block;
    width: 100%;
    /* Sin esto manda el height="800" de la etiqueta y la proporción de abajo
       no llega a aplicarse. */
    height: auto;
    /* Proporción de la foto, sin recortar: lo que se tiene que leer es la
       rotulación de la furgoneta. */
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--r-lg);
    box-shadow: 0 30px 60px -25px rgba(17, 26, 36, .4);
  }
  /* Sello pegado sobre la foto, en la esquina del asfalto, que es la zona
     lisa: encima de la furgoneta taparía la rotulación.
     Va con el padre en el selector porque ".whyus__media > *" de arriba le
     gana en prioridad y lo devolvería al flujo normal, debajo de la foto. */
  .whyus__media > .whyus__badge {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .25rem;
    padding: 1.1rem 1.6rem;
    background: var(--c-navy);
    color: var(--c-white);
    border: 3px solid var(--c-orange);
    border-radius: var(--r-md);
    box-shadow: var(--sh-2xl);
    transform: rotate(-3deg);
  }
  .whyus__badge-eyebrow {
    font-size: var(--fs-2xs);
    font-weight: var(--fw-black);
    text-transform: uppercase;
    letter-spacing: .3em;
    color: var(--c-orange);
  }
  .whyus__badge-value {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: var(--fw-black);
    text-transform: uppercase;
    line-height: 1;
  }
  .whyus__badge-sub {
    font-size: var(--fs-2xs);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--c-gray-400);
  }
  /* En pantallas pequeñas el sello se encoge, pero sigue pegado a la foto:
     si se sale, deja de ser un sello. */
  @media (max-width: 560px) {
    .whyus__media > .whyus__badge { right: .75rem; bottom: .75rem; padding: .6rem .9rem; gap: .1rem; }
    .whyus__badge-eyebrow { font-size: .55rem; letter-spacing: .16em; }
    .whyus__badge-value { font-size: 1.2rem; }
    .whyus__badge-sub { font-size: .55rem; }
  }
</style>
