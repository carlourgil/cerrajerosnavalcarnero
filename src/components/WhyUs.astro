---
import { SITE } from "../lib/config";

const features = [
  {
    title: "Presupuesto cerrado",
    desc: "Te damos el precio final por teléfono. Sin sorpresas, sin abusos.",
    icon: "check",
  },
  {
    title: "Apertura sin daños",
    desc: "Expertos en ganzuado y técnicas limpias. Tu puerta quedará perfecta.",
    icon: "shield",
  },
];
---

<section id="ventajas" class="section band-light">
  <div class="container">
    <div class="zigzag">
      <div>
        <h2>
          Tu vecino en la<br />
          <span class="accent">{SITE.landmark}</span>
        </h2>
        <p class="subhead measure">
          En <strong>{SITE.businessName}</strong> no somos una centralita fría de internet. Somos cerrajeros
          que trabajan en <strong class="whyus__mark">{SITE.location}</strong>.
        </p>

        <div class="whyus__list">
          {
            features.map((f) => (
              <div class="whyus__card">
                <span class="whyus__icon">
                  {f.icon === "check" && (
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9"></circle>
                      <path d="M8.5 12.5l2.5 2.5 4.5-5"></path>
                    </svg>
                  )}
                  {f.icon === "shield" && (
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3l7 3v5c0 4.4-2.9 8.3-7 9.5C7.9 19.3 5 15.4 5 11V6l7-3z"></path>
                    </svg>
                  )}
                </span>
                <div>
                  <h3 class="whyus__title">{f.title}</h3>
                  <p class="whyus__desc">{f.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="whyus__media">
        <div class="whyus__photo">[PENDIENTE: foto del técnico trabajando en {SITE.location}]</div>
        <div class="whyus__badge">
          <span class="whyus__badge-eyebrow">Confianza local</span>
          <span class="whyus__badge-value">{SITE.yearsActive} años</span>
          <span class="whyus__badge-sub">Abriendo {SITE.location}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .whyus__mark {
    color: var(--c-navy);
    font-weight: var(--fw-black);
    text-decoration: underline;
    text-decoration-color: var(--c-orange);
    text-decoration-thickness: 4px;
    text-underline-offset: 4px;
  }
  .whyus__list { display: grid; gap: 2rem; margin-top: 3rem; }
  .whyus__card {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 2rem;
    background: var(--c-gray-50);
    border: 1px solid var(--c-gray-100);
    border-radius: var(--r-xl);
    transition: background var(--ease), box-shadow var(--ease);
  }
  .whyus__card:hover { background: var(--c-white); box-shadow: var(--sh-float); }
  .whyus__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: var(--r-sm);
    background: rgba(238, 108, 77, .1);
    color: var(--c-orange);
    transition: background var(--ease), color var(--ease);
  }
  .whyus__card:hover .whyus__icon { background: var(--c-orange); color: var(--c-white); }
  .whyus__title {
    margin: 0 0 .25rem;
    font-size: 1.5rem;
    color: var(--c-navy);
  }
  .whyus__desc { margin: 0; color: var(--c-gray-500); font-weight: 500; }

  .whyus__media { position: relative; }
  .whyus__photo {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    aspect-ratio: 4 / 5;
    padding: 2rem;
    border: 8px solid var(--c-white);
    border-radius: var(--r-2xl);
    background: var(--c-gray-100);
    box-shadow: var(--sh-2xl);
    color: var(--c-gray-500);
    font-weight: var(--fw-bold);
  }
  .whyus__badge {
    position: absolute;
    right: -1rem;
    bottom: -2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .35rem;
    padding: 2rem;
    background: var(--c-navy);
    color: var(--c-white);
    border: 4px solid var(--c-orange);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-2xl);
    transform: rotate(3deg);
  }
  .whyus__badge-eyebrow {
    font-size: var(--fs-2xs);
    font-weight: var(--fw-black);
    text-transform: uppercase;
    letter-spacing: .3em;
    color: var(--c-orange);
  }
  .whyus__badge-value {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: var(--fw-black);
    font-style: italic;
    text-transform: uppercase;
    line-height: 1;
  }
  .whyus__badge-sub {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    color: var(--c-gray-400);
  }
  @media (max-width: 767px) {
    .whyus__badge { position: static; transform: none; margin-top: 1.5rem; }
  }
</style>
