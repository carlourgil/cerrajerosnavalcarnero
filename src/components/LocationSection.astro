---
import { SITE } from "../lib/config";
---

<section class="section band-light">
  <div class="container">
    <div class="zigzag">
      <div>
        <span class="eyebrow">Dónde estamos</span>
        <h2>{SITE.businessName}</h2>
        <ul class="ticks">
          <li><strong>Dirección:</strong> {SITE.address}</li>
          <li><strong>Teléfono:</strong> {SITE.phoneDisplay}</li>
          <li><strong>Email:</strong> {SITE.email}</li>
          <li><strong>Horario:</strong> {SITE.hours}</li>
          <li><strong>Zona de servicio:</strong> {SITE.serviceArea}</li>
        </ul>
      </div>
      <div class="map-placeholder">
        [PENDIENTE: incrusta aquí el mapa de Google Maps con tu ubicación o zona de servicio]
      </div>
    </div>
  </div>
</section>

<style>
  .map-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    aspect-ratio: 4 / 3;
    padding: 2rem;
    background: var(--c-gray-100);
    border-radius: var(--r-2xl);
    color: var(--c-gray-500);
    font-weight: var(--fw-bold);
  }
</style>
