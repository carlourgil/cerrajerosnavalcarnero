---
import { SITE } from "../lib/config";
---

<section id="zona" class="section band-light">
  <div class="container">
    <div class="zigzag">
      <div>
        <span class="eyebrow">Dónde trabajamos</span>
        <h2>Dirección y cobertura de <span class="accent">{SITE.businessName}</span></h2>
        <p class="subhead measure">
          Cerrajería a domicilio en {SITE.location} para viviendas, comunidades y negocios.
          Atendemos urgencias las 24 horas y te confirmamos el precio y el tiempo estimado
          de llegada antes de desplazarnos.
        </p>

        <ul class="ticks">
          <li><strong>Zona:</strong> {SITE.serviceArea} y sus barrios ({SITE.postalCode})</li>
          <li><strong>Dirección:</strong> {SITE.streetAddress}, {SITE.postalCode}, {SITE.addressCity}</li>
          <li><strong>Llegada estimada:</strong> {SITE.arrivalTime}</li>
          <li><strong>Horario:</strong> {SITE.hours}</li>
          <li><strong>Teléfono:</strong> <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></li>
          <li><strong>Email:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        </ul>

      </div>

      <iframe
        class="map"
        src={`https://www.google.com/maps?q=${encodeURIComponent(`${SITE.streetAddress}, ${SITE.postalCode}, ${SITE.addressCity}`)}&output=embed`}
        title={`Dirección de ${SITE.businessName}: ${SITE.streetAddress}, ${SITE.location}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .map {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--c-gray-200);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-card);
  }
</style>
