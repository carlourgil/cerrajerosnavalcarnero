---
import { SITE } from "../lib/config";
---

<section class="section band-light">
  <div class="container">
    <div class="zigzag">
      <div>
        <span class="eyebrow">Dónde estamos</span>
        <h2>{SITE.businessName}</h2>
        <ul class="ticks">
          <li><strong>Dirección:</strong> {SITE.address}</li>
          <li><strong>Teléfono:</strong> {SITE.phoneDisplay}</li>
          <li><strong>Email:</strong> {SITE.email}</li>
          <li><strong>Horario:</strong> {SITE.hours}</li>
          <li><strong>Zona de servicio:</strong> {SITE.serviceArea}</li>
        </ul>
      </div>
      <iframe
        class="map"
        src={`https://www.google.com/maps?q=${encodeURIComponent(`${SITE.location}, Madrid`)}&output=embed`}
        title={`Zona de servicio en ${SITE.location}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

<style>
  /* Mapa del municipio mientras no haya local propio: en cuanto exista la
     ficha de Google Business, se cambia por su mapa. */
  .map {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--c-gray-200);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-card);
  }
</style>
