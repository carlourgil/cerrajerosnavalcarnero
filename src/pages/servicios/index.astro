---
import Layout from "../../layouts/Layout.astro";
import Services from "../../components/Services.astro";
import ContactForm from "../../components/ContactForm.astro";
import { SITE } from "../../lib/config";
---

<Layout
  title={`Servicios de cerrajería en ${SITE.location} | ${SITE.businessName}`}
  description={`Cerrajería en ${SITE.location} para viviendas, comunidades y negocios. Aperturas, cambio de cerraduras y bombines de seguridad. Atención 24 horas con presupuesto previo.`}
>
  <main>
    <section class="page-hero">
      <div class="container">
        <span class="eyebrow">{SITE.location} · 24 horas</span>
        <h1>Servicios de cerrajería en {SITE.location}</h1>
        <p class="subhead measure">
          Lo que hacemos en {SITE.serviceArea}, con precio cerrado por teléfono antes de desplazarnos.
        </p>
      </div>
    </section>

    <Services />
    <ContactForm quote />
  </main>
</Layout>
