---
import Layout from "../../layouts/Layout.astro";
import Services from "../../components/Services.astro";
import ContactForm from "../../components/ContactForm.astro";
import { SITE } from "../../lib/config";
---

<Layout
  title={`Servicios de cerrajería en ${SITE.location} | ${SITE.businessName}`}
  description={`Servicios de cerrajería que hacemos en ${SITE.serviceArea}: apertura de puertas, coches y cajas fuertes, cambio de cerraduras, bombines antibumping y urgencias 24 h.`}
>
  <main>
    <section class="page-hero">
      <div class="container">
        <span class="eyebrow">{SITE.location} · 24 horas</span>
        <h1>Servicios</h1>
        <p class="subhead measure">
          Lo que hacemos en {SITE.serviceArea}, con precio cerrado por teléfono antes de desplazarnos.
        </p>
      </div>
    </section>

    <Services />
    <ContactForm quote />
  </main>
</Layout>
