---
import Layout from "../../layouts/Layout.astro";
import CTA from "../../components/CTA.astro";
import ContactForm from "../../components/ContactForm.astro";
import { services } from "../../data/services";
import { SITE } from "../../lib/config";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const showOpeningRates = service.slug === "urgencias-24h" || service.slug === "apertura-de-puertas";
const heading = service.slug === "cambio-de-cerraduras" ? "Cambio de cerradura" : service.title;
const others = services.filter((s) => s.slug !== service.slug).slice(0, 3);
---

<Layout
  title={`${heading} en ${SITE.location} | ${SITE.businessName}`}
  description={service.metaDescription ?? service.description}
  breadcrumbs={[
    { name: "Servicios", path: "/servicios/" },
    { name: service.title, path: `/servicios/${service.slug}/` },
  ]}
  service={service}
>
  <main>
    <section class="page-hero">
      <div class:list={["container", { "service-hero": service.image }]}>
        <div>
          <span class="eyebrow">{SITE.location} · 24 horas</span>
          <h1>{heading} en {SITE.location}</h1>
          <p class="subhead measure">{service.description}</p>
          <a href={`tel:${SITE.phone}`} class="btn btn--accent">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 006.5 6.5l1.5-2 4 1.5v3a2 2 0 01-2.2 2A17 17 0 014.5 5.2 2 2 0 016.5 3z"></path>
            </svg>
            <span class="btn__stack">
              <span class="btn__eyebrow">Llama ahora</span>
              <span>{SITE.phoneDisplay}</span>
            </span>
          </a>
        </div>
        {service.image && (
          <img
            class="service-hero__photo"
            src={`/images/${service.image}-480.webp`}
            width="480"
            height="320"
            alt={service.imageAlt ?? ""}
            fetchpriority="high"
            decoding="async"
          />
        )}
      </div>
    </section>

    <section class="section band-light">
      <div class="container">
        <div class="section-head">
          <h2>Qué incluye el servicio de <span class="accent">{service.title.toLowerCase()}</span></h2>
        </div>
        <ul class="detail-list">
          {
            service.bullets.map((b) => (
              <li>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 12.5l5 5L20 6.5"></path>
                </svg>
                {b}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section band-light">
      <div class="container">
        <div class="prose">
          {service.intro.map((p) => <p class="prose__lead">{p}</p>)}

          {
            service.sections.map((block) => (
              <div class="prose__block">
                <h2>{block.title}</h2>
                {block.body.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section band-muted">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Dudas frecuentes</span>
          <h2>Preguntas frecuentes sobre <span class="accent">{service.title.toLowerCase()}</span></h2>
        </div>
        <div class="faq-list">
          {
            service.faqs.map((f) => (
              <details class="faq-item">
                <summary>
                  {f.q}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {showOpeningRates && <CTA />}
    {!showOpeningRates && <ContactForm quote serviceSlug={service.slug} />}

    <section class="section band-muted">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Más servicios</span>
          <h2>Otros servicios de cerrajería en {SITE.location}</h2>
        </div>
        <div class="grid">
          {
            others.map((s) => (
              <a href={`/servicios/${s.slug}/`} class="card">
                <div class="card__body">
                  <h3 class="card__subtitle">{s.title}</h3>
                  <p>{s.short}</p>
                  <span class="card__link">
                    Ver detalles
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14M13 6l6 6-6 6"></path>
                    </svg>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .service-hero {
    display: grid;
    align-items: center;
    gap: clamp(1.75rem, 4vw, 4rem);
  }
  .service-hero__photo {
    display: block;
    width: 100%;
    max-width: 30rem;
    height: auto;
    border-radius: var(--r-lg);
    box-shadow: var(--sh-float);
  }
  @media (min-width: 900px) {
    .service-hero {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }
    .service-hero__photo {
      justify-self: end;
    }
  }

  .detail-list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 52rem;
    display: grid;
    gap: 1rem;
  }
  .detail-list li {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 2rem;
    background: var(--c-gray-50);
    border: 1px solid var(--c-gray-100);
    border-radius: var(--r-lg);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--c-navy);
  }
  .detail-list svg { color: var(--c-orange); flex-shrink: 0; }

  /* Texto largo del servicio. Medida corta a propósito: pasado de 70 caracteres
     por línea se pierde el renglón al volver. */
  .prose { max-width: 44rem; margin-inline: auto; }
  .prose__lead {
    font-size: 1.1875rem;
    line-height: 1.65;
    color: var(--c-gray-600);
  }
  .prose__lead:first-child { color: var(--c-ink); }
  .prose__block { margin-top: 3rem; }
  .prose__block h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: var(--c-navy);
  }
  .prose__block p { color: var(--c-gray-600); }
  .prose p + p { margin-top: 1rem; }

  .faq-list {
    max-width: 44rem;
    margin-inline: auto;
    display: grid;
    gap: .75rem;
  }
  .faq-item {
    background: var(--c-white);
    border: 1px solid var(--c-gray-100);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 1.75rem;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--c-navy);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary svg {
    flex-shrink: 0;
    color: var(--c-orange);
    transition: transform var(--ease);
  }
  .faq-item[open] summary svg { transform: rotate(180deg); }
  .faq-item[open] { border-color: var(--c-orange); }
  .faq-item p {
    margin: 0;
    padding: 0 1.75rem 1.5rem;
    color: var(--c-gray-600);
    max-width: 62ch;
  }
</style>
