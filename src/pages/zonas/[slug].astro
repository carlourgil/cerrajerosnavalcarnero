---
import Layout from "../../layouts/Layout.astro";
import CTA from "../../components/CTA.astro";
import WhoComes from "../../components/WhoComes.astro";
import { zones } from "../../data/zones";
import { services } from "../../data/services";
import { SITE } from "../../lib/config";

export function getStaticPaths() {
  return zones.map((zone) => ({
    params: { slug: zone.slug },
    props: { zone },
  }));
}

const { zone } = Astro.props;
const place = `${zone.name}, ${SITE.location}`;
---

<Layout
  title={`Cerrajeros en ${place} | ${SITE.businessName}`}
  description={`Cerrajero 24 h en ${place}. ${zone.short}. Apertura de puertas sin daños, cambio de cerraduras y bombines antibumping. Llegada estimada de ${zone.arrivalTime}.`}
  breadcrumbs={[
    { name: "Zonas", path: "/zonas/" },
    { name: zone.name, path: `/zonas/${zone.slug}/` },
  ]}
>
  <main>
    <section class="page-hero">
      <div class="container">
        <span class="eyebrow">{SITE.location} · 24 horas</span>
        <h1>Cerrajeros en {zone.name}</h1>
        <p class="subhead measure">{zone.short}. Llegada estimada de {zone.arrivalTime} y precio cerrado por teléfono antes de salir.</p>
        <a href={`tel:${SITE.phone}`} class="btn btn--accent">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 006.5 6.5l1.5-2 4 1.5v3a2 2 0 01-2.2 2A17 17 0 014.5 5.2 2 2 0 016.5 3z"></path>
          </svg>
          <span class="btn__stack">
            <span class="btn__eyebrow">Llama ahora</span>
            <span>{SITE.phoneDisplay}</span>
          </span>
        </a>
      </div>
    </section>

    <section class="section band-light">
      <div class="container">
        <div class="prose">
          {zone.intro.map((p) => <p class="prose__lead">{p}</p>)}

          {
            zone.sections.map((block) => (
              <div class="prose__block">
                <h2>{block.title}</h2>
                {block.body.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            ))
          }

          <div class="prose__block">
            <h2>Lo que más encaja con {zone.name}</h2>
            <ul class="zone-list">
              {
                zone.typical.map((t) => (
                  <li>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 12.5l5 5L20 6.5" />
                    </svg>
                    {t}
                  </li>
                ))
              }
            </ul>
            <p class="zone-list__note">
              No es un listado de encargos concretos: es lo que suele aparecer por el tipo de
              vivienda que hay en la zona. Hacemos los seis servicios en todo {SITE.location}.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section band-muted">
      <div class="container">
        <div class="section-head">
          <h2>Servicios en <span class="accent">{zone.name}</span></h2>
        </div>
        <div class="grid">
          {
            services.map((s) => (
              <a href={`/servicios/${s.slug}/`} class="card">
                <div class="card__body">
                  <h4>{s.title}</h4>
                  <p>{s.short}</p>
                  <span class="card__link">
                    Ver detalles
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14M13 6l6 6-6 6"></path>
                    </svg>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <WhoComes zoneName={zone.name} arrivalTime={zone.arrivalTime} />
    <CTA />
  </main>
</Layout>

<style>
  /* Misma medida de lectura que en las páginas de servicio. */
  .prose { max-width: 44rem; margin-inline: auto; }
  .prose__lead {
    font-size: 1.1875rem;
    line-height: 1.65;
    color: var(--c-gray-600);
  }
  .prose__lead:first-child { color: var(--c-ink); }
  .prose__block { margin-top: 3rem; }
  .prose__block h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: var(--c-navy);
  }
  .prose__block p { color: var(--c-gray-600); }
  .prose p + p { margin-top: 1rem; }

  .zone-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .75rem; }
  .zone-list li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--c-gray-50);
    border: 1px solid var(--c-gray-100);
    border-radius: var(--r-sm);
    font-weight: 600;
    color: var(--c-navy);
  }
  .zone-list svg { color: var(--c-orange); flex-shrink: 0; }
  .zone-list__note {
    margin-top: 1.25rem;
    font-size: var(--fs-sm);
    color: var(--c-gray-400);
  }
</style>
