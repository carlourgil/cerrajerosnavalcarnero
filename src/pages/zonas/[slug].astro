---
import Layout from "../../layouts/Layout.astro";
import CTA from "../../components/CTA.astro";
import { zones } from "../../data/zones";
import { services } from "../../data/services";
import { SITE } from "../../lib/config";

export function getStaticPaths() {
  return zones.map((zone) => ({
    params: { slug: zone.slug },
    props: { zone },
  }));
}

const { zone } = Astro.props;
const place = `${zone.name}, ${SITE.location}`;
---

<Layout
  title={`Cerrajeros en ${place} | ${SITE.businessName}`}
  description={`Cerrajero urgente 24 h en ${place}. Apertura de puertas sin daños, cambio de cerraduras y bombines antibumping. Llegada media ${SITE.arrivalTime}.`}
>
  <main>
    <section class="page-hero">
      <div class="container">
        <span class="eyebrow">{SITE.location} · 24 horas</span>
        <h1>Cerrajeros en {zone.name}</h1>
        <p class="subhead measure">
          Atendemos avisos en {zone.name} a cualquier hora. La llegada media es de {SITE.arrivalTime} y te
          damos el precio cerrado por teléfono antes de salir.
        </p>
        <a href={`tel:${SITE.phone}`} class="btn btn--accent">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 006.5 6.5l1.5-2 4 1.5v3a2 2 0 01-2.2 2A17 17 0 014.5 5.2 2 2 0 016.5 3z"></path>
          </svg>
          <span class="btn__stack">
            <span class="btn__eyebrow">Llama ahora</span>
            <span>{SITE.phoneDisplay}</span>
          </span>
        </a>
      </div>
    </section>

    <section class="section band-light">
      <div class="container">
        <div class="section-head">
          <h2>Servicios en <span class="accent">{zone.name}</span></h2>
        </div>
        <div class="grid">
          {
            services.map((s) => (
              <a href={`/servicios/${s.slug}/`} class="card">
                <div class="card__body">
                  <h4>{s.title}</h4>
                  <p>{s.short}</p>
                  <span class="card__link">
                    Ver detalles
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14M13 6l6 6-6 6"></path>
                    </svg>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <CTA />
  </main>
</Layout>
