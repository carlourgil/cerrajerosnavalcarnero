---
import Layout from "../../layouts/Layout.astro";
import CTA from "../../components/CTA.astro";
import { zones } from "../../data/zones";
import { services } from "../../data/services";
import { SITE } from "../../lib/config";

export function getStaticPaths() {
  return zones.map((zone) => ({
    params: { slug: zone.slug },
    props: { zone },
  }));
}

const { zone } = Astro.props;
const place = zone.kind === "barrio" ? `${zone.name}, ${SITE.location}` : zone.name;
const eyebrow = zone.kind === "barrio" ? SITE.location : `Cerca de ${SITE.location}`;
---

<Layout
  title={`Cerrajeros en ${place} | ${SITE.businessName}`}
  description={`Cerrajero urgente 24h en ${place}. Apertura de puertas, cambio de cerraduras y bombines. Llegada media ${SITE.arrivalTime}.`}
>
  <main>
    <section class="section band-dark text-center">
      <div class="container" style="max-width: 760px;">
        <span class="eyebrow">{eyebrow}</span>
        <h1>Cerrajeros en {zone.name}</h1>
        <p class="subhead">
          Servicio de cerrajería urgente en {zone.name}. Llegada media de {SITE.arrivalTime}.
        </p>
        <a href={`tel:${SITE.phone}`} class="btn btn--accent">📞 Llamar ahora: {SITE.phoneDisplay}</a>
      </div>
    </section>

    <section class="section band-light">
      <div class="container">
        <h2 class="text-center" style="margin-bottom: 2rem;">Servicios disponibles en {zone.name}</h2>
        <div class="grid">
          {
            services.map((s) => (
              <a href={`/servicios/${s.slug}/`} class="btn btn--ghost btn--block">
                {s.title}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <CTA />
  </main>
</Layout>
