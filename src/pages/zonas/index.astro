---
import Layout from "../../layouts/Layout.astro";
import Zones from "../../components/Zones.astro";
import CTA from "../../components/CTA.astro";
import { SITE } from "../../lib/config";
---

<Layout
  title={`Zonas de servicio en ${SITE.location} | ${SITE.businessName}`}
  description={`Cerrajeros 24 horas en los barrios de ${SITE.location}. Consulta tu zona, el tiempo estimado de llegada y los servicios de NavaLlave para tu vivienda o negocio.`}
>
  <main>
    <section class="page-hero">
      <div class="container">
        <span class="eyebrow">Cobertura</span>
        <h1>Zonas de servicio en {SITE.location}</h1>
        <p class="subhead measure">
          Cubrimos {SITE.serviceArea}, barrio por barrio. Elige el tuyo y verás qué nos solemos
          encontrar por ahí y cuánto tardamos en llegar.
        </p>
      </div>
    </section>

    <Zones />
    <CTA />
  </main>
</Layout>
