---
import Layout from "../../layouts/Layout.astro";
import Zones from "../../components/Zones.astro";
import CTA from "../../components/CTA.astro";
import { SITE } from "../../lib/config";
---

<Layout
  title={`Zonas de servicio en ${SITE.location} | ${SITE.businessName}`}
  description={`Barrios de ${SITE.location} donde atendemos avisos de cerrajería 24 h: Centro, El Pinar, La Dehesa, San Andrés, San Isidro, El Pijorro, Los Manzanos y el Polígono Alparrache.`}
>
  <main>
    <section class="page-hero">
      <div class="container">
        <span class="eyebrow">Cobertura</span>
        <h1>Dónde llegamos</h1>
        <p class="subhead measure">
          Cubrimos {SITE.serviceArea}, barrio por barrio. Elige el tuyo y verás qué nos solemos
          encontrar por ahí y cuánto tardamos en llegar.
        </p>
      </div>
    </section>

    <Zones />
    <CTA />
  </main>
</Layout>
